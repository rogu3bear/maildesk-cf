{
  "name": "maildesk-cf",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:ui": "python3 -B scripts/build-workflow.py build:ui",
    "build:router-wasm": "python3 -B scripts/build-workflow.py build:router-wasm",
    "build:mail-workers": "python3 -B scripts/build-workflow.py build:mail-workers",
    "check:mail-worker-bundles": "python3 -B scripts/build-workflow.py check:mail-worker-bundles",
    "ci": "python3 -B scripts/build-workflow.py ci",
    "ci:retire": "python3 -B scripts/build-and-retire.py",
    "check": "bun run typecheck",
    "preflight": "python3 -B scripts/build-workflow.py preflight",
    "preflight:template": "python3 -B scripts/build-workflow.py preflight --mode template",
    "preflight:production": "python3 -B scripts/build-workflow.py preflight --mode production",
    "check:cfctl-provisioning": "bun run scripts/check-cfctl-provisioning.ts",
    "check:domain-enrollment": "bun run scripts/check-domain-enrollment.ts",
    "compile:fleet-readiness": "bun run scripts/compile-fleet-readiness.ts",
    "check:relay-topology": "bun run scripts/check-relay-topology.ts",
    "plan:dark": "bun run scripts/compile-dark-plan.ts",
    "materialize:d1-preview-config": "bun run scripts/materialize-d1-preview-config.ts",
    "check:maildesk-closeout": "bun run scripts/check-maildesk-closeout.ts",
    "apply:maildesk-acks": "bun run scripts/apply-sender-domain-ack-manifest.ts",
    "test:scripts": "python3 -B scripts/build-workflow.py test:scripts",
    "test:workers": "python3 -B scripts/build-workflow.py test:workers",
    "typecheck": "python3 -B scripts/build-workflow.py typecheck",
    "check:ui": "python3 -B scripts/build-workflow.py check:ui",
    "collect:maildesk-evidence": "bun run scripts/collect-live-evidence.ts",
    "plan:maildesk-proofs": "bun run scripts/plan-mail-proofs.ts",
    "receipt:maildesk": "bun run scripts/receipt-maildesk.ts",
    "refresh:maildesk-acks": "bun run scripts/refresh-sender-domain-ack-manifest.ts",
    "send:maildesk-probes": "bun run scripts/send-mail-probes.ts",
    "verify:maildesk": "bun run scripts/verify-maildesk.ts",
    "provision:email-routing": "bun run scripts/provision-email-routing.ts",
    "sync:route-policy": "bun run scripts/sync-route-policy.ts",
    "typecheck:workers": "tsc -p tsconfig.workers.json --noEmit",
    "plan:ordinary-reply": "bun scripts/compile-route-reply-operation.ts activation",
    "plan:dispatch-recovery": "bun scripts/compile-route-reply-operation.ts recovery",
    "plan:route-quarantine": "bun scripts/compile-route-reply-operation.ts containment",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "check:template": "python3 -B scripts/build-workflow.py template"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@cloudflare/workers-types": "5.20260815.1",
    "@types/node": "^25.9.3",
    "esbuild": "0.28.1",
    "typescript": "^5.9.3",
    "wrangler": "4.124.0",
    "@types/bun": "1.3.14"
  },
  "overrides": {
    "ws": "8.21.0",
    "esbuild": "0.28.1"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "jose": "6.2.8",
    "postal-mime": "2.7.5",
    "zod": "4.6.7"
  }
}
