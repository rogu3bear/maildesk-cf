#!/usr/bin/env bash
# The repository gate is reached through the independently pinned global chain.
# Verify that Git actually selects that chain and this hook's reviewed bytes.
set -euo pipefail
DELEGATE="$HOME/.config/git/guards/delegate-repo-hook.sh"
if [ ! -x "$DELEGATE" ]; then
  echo 'required global Git guard is unavailable' >&2
  exit 1
fi
"$DELEGATE" --verify-chain pre-push >&2
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec python3 -B "$ROOT_DIR/scripts/source_qualification.py" --verify-push "$@"
