CLOUDFLARE_ACCOUNT_ID=<account-id>
CLOUDFLARE_API_TOKEN=<api-token>
CFCTL_BIN=cfctl
# Optional explicit cfctl profile. Prefer this over changing shared global
# profile selection on multi-repository operator hosts.
MAILDESK_CFCTL_PROFILE=<profile-id>
MAILDESK_POLICY_PATH=config/policy.example.json
MAILDESK_PROJECT_NAME=maildesk-cf
# Inbox relay is configured but held dark until the protected canary enables
# processing. These values must match the selected desired-state file.
MAILDESK_OPERATOR_DELIVERY_MODE=inbox_relay
MAILDESK_RELAY_PROCESSING_MODE=disabled
MAILDESK_REPLY_DOMAIN=reply.maildesk.example.com
MAILDESK_REPLY_TOKEN_TTL_DAYS=90
MAILDESK_SPOOL_RETENTION_DAYS=7
MAILDESK_MAX_ENCODED_MESSAGE_BYTES=5242880
# The legacy bearer-token reply API is opt-in; the Access-protected Leptos
# desk does not require it.
MAILDESK_REPLY_API_MODE=disabled
MAILDESK_API_TOKEN=<local-reply-api-token>
MAILDESK_PROOF_API_TOKEN=<optional-proof-reply-api-token>
MAILDESK_ACCESS_TEAM_DOMAIN=<access-team-domain>
MAILDESK_ACCESS_AUD=<access-application-aud>
MAILDESK_OUTBOUND_MODE=disabled
# Required only when MAILDESK_OUTBOUND_MODE is cloudflare_email_service or resend.
MAILDESK_VERIFIED_SENDER_DOMAINS=
# Required only when MAILDESK_OUTBOUND_MODE is resend.
RESEND_API_KEY=
